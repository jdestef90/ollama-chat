# Ollama Terminal-Chat (OTC) Environment Configuration

# Ollama local endpoint
# On Linux/macOS/Windows in Docker, use http://host.docker.internal:11434
# For direct node runs on host, use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional OpenAI / OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Server port (default: 3000)
PORT=3000

# Debug logging
DEBUG_MODE=false
